{
  "expo": {
    "name": "Spare Plate",
    "slug": "spare-plate",
    "scheme": "spareplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spareplate.app"
    },
    "android": {
      "package": "com.spareplate.app",
      "backgroundColor": "#F8FAFC"
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
